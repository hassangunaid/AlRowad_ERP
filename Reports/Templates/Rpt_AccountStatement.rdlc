					<!-- السطر الثاني من الخلاصة: إنزال الرصيد الختامي تحت عموده + التفقيط بالحروف -->
					<Textbox Name="Final_Credit_Balance">
						<CanGrow>true</CanGrow>
						<KeepTogether>true</KeepTogether>
						<Paragraphs>
							<Paragraph>
								<TextRuns>
									<TextRun>
										<Value>=IIF(First(Fields!Total_Credit.Value, "Rpt_AccountStatement") &gt; First(Fields!Total_Debit.Value, "Rpt_AccountStatement"), First(Fields!Final_Balance.Value, "Rpt_AccountStatement"), 0)</Value>
										<Style>
											<FontWeight>Bold</FontWeight>
											<Color>DarkBlue</Color>
											<Format>=Parameters!NumberFormat.Value</Format>
										</Style>
									</TextRun>
								</TextRuns>
								<Style>
									<TextAlign>Center</TextAlign>
								</Style>
							</Paragraph>
